{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "echo 'No build step: the Express app runs as a Vercel Function (api/index.js)'",
  "outputDirectory": "public",
  "regions": ["cdg1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{src,public}/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
