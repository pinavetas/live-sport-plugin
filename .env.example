# Port the addon server will listen on
PORT=7000

# Required in production for signed zero-bandwidth HLS byte-range redirects.
# Set APP_SECRET to a unique, private random value (for example, generate one
# with "openssl rand -hex 32"). Never commit the real secret to the repository.
# All PM2 cluster workers/replicas must receive the SAME persistent secret.
# SESSION_SECRET remains accepted as a backward-compatible alternative.
# Without either variable, production disables signed redirects (HTTP 503),
# logs a fatal configuration message and keeps the addon running. Redirect-mode
# manifests use direct CDN segment URLs instead. No video proxy is enabled.
# Development/tests use a process-local random secret that changes on restart.
# APP_SECRET=your-generated-secret-here

# Optional: Public base URL of this addon.
# Used to build absolute proxy/manifest URLs (see src/config.js).
# Example (production); leave unset for local dev (auto-detected).
ADDON_URL=https://nuviosports.xyz

# Optional: Dedicated public streaming origin (e.g. https://stream.nuviosports.xyz)
# When set, all video stream endpoints (/api/dash/*, /api/manifest*, etc.) resolve
# to this domain, keeping heavy video bytes completely off Cloudflare's CDN proxy.
# Defaults to ADDON_URL if unset.
STREAM_URL=https://stream.nuviosports.xyz

# Optional: Residential Proxy to bypass Cloudflare without Playwright
# Format: http://username:password@proxy-host.com:port
RESIDENTIAL_PROXY=

# Optional: Cloudflare Worker proxy URL (e.g., https://nuvio-proxy.yourname.workers.dev)
# If provided, edge scraping (like CDNLive) will be routed through this worker.
CF_PROXY_URL=

# --- Cloaked (.image) segment addressing ---
# direct   (default) Hand the upstream CDN URI to the player. #EXT-X-BYTERANGE
#          tells it which bytes to take; the CDN serves the range itself.
#          Works on Stremio/ExoPlayer, MPV and Nuvio with 0 VPS bandwidth.
# redirect Bounce the player Range request to the CDN with a 307. ExoPlayer does
#          not follow the cross-protocol (http addon -> https CDN) redirect, so
#          Stremio playback fails. Rollback switch only.
# proxy    Stream the bytes through the CF worker pool / /api/hlschunk (costs
#          server bandwidth).
TIKTOK_SEGMENT_MODE=direct

# --- Cloudflare worker pool budgets (.image segment de-cloaking) ---
# Comma-separated free worker origins. Leave unset to use the six defaults in
# src/services/WorkerBudget.js. The paid worker below is always excluded from
# this list, whatever you put here.
CF_WORKER_POOL=

# The single paid worker (10M requests/month included). Free workers are spent
# first; this one only takes the overflow.
CF_PAID_WORKER_URL=

# Stop each free worker at 90% of its 100k/day plan limit, so drift in the
# emission counter never turns into a hard stop.
CF_FREE_CAP_RATIO=0.9

# Paid worker soft warn ratio (warns at 9.5M before 10M included billing threshold).
# CF_PAID_CAP_RATIO is also accepted as a legacy alias.
CF_PAID_SOFT_STOP_RATIO=0.95

# Hard ceiling for paid worker (monthly requests) before cutting off to prevent runaway billing.
CF_PAID_HARD_LIMIT=20000000

# PM2 cluster instances sharing these caps (counters are per process).
# Match this to the instances value in ecosystem.config.js.
WORKER_INSTANCE_COUNT=1

# Production default: off.
# When both CF worker tiers are exhausted, emit the upstream URL directly
# (0 VPS bandwidth bleed). Set to 'on' only as a temporary escape hatch
# if an essential stream must play regardless of VPS transfer costs.
HLSCUNK_FALLBACK=off

# How long a segment URL keeps its assigned worker without spending more
# budget (a live playlist re-emits its whole window on every fetch).
CF_DEDUPE_TTL_MS=120000
CF_DEDUPE_MAX_ENTRIES=20000

# Periodic [WorkerBudget] usage snapshot; off silences it entirely.
WORKER_POOL_LOG=on
WORKER_POOL_LOG_INTERVAL_MS=300000

# Optional: secret token to protect /api/worker-budget (?token=...). Leave unset for public access.
WORKER_BUDGET_TOKEN=

# Vavoo 24/7 Live TV Provider (Dual-Ping Architecture)
# Enables 1,800+ verified live channels across 17 countries with 0% server video bandwidth.
# Set to 'true' to enable, or 'false'/unset to keep disabled.
VAVOO_ENABLED=false

# AI Parser Studio (/api/parser/*). Direct local requests (loopback/LAN, no proxy
# forwarding headers) are always allowed. To use the studio remotely, set a long
# random secret here and send it as the `x-parser-studio-token` header (or
# ?token=...); the configure page asks for it and keeps it in localStorage.
# Unset => the studio API is local-only (remote callers get 401).
PARSER_STUDIO_TOKEN=

# =============================================================================
# Everything below is optional. Lines are commented out and show the built-in
# default; uncomment only what you want to change. Note that an empty value is
# NOT always the same as unset (e.g. PREWARM_SKIP_PROVIDERS= disables the list).
# =============================================================================

# --- Server binding ---
# Interface to bind (IP is accepted as an alias). Also passed to the resolver.
# HOST=0.0.0.0
# Port of the internal resolver child process (resolver/).
# RESOLVER_PORT=7003
# Public base URL the resolver uses for absolute links (defaults to Host header).
# BASE_URL=
# RENDER_EXTERNAL_URL / WEBSITE_HOSTNAME are set by Render / Azure automatically
# and are used as ADDON_URL fallbacks; do not set them by hand.

# --- AI Parser Studio / custom AI sources (src/services/AiParserGeneratorService.js) ---
# OpenAI-compatible endpoint, key and model used to generate replay parsers.
# OPENCODE_API_URL / OPENCODE_API_KEY are accepted as legacy aliases.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat
# Cron schedule for refreshing AI-generated custom sources (src/services/CronService.js).
# CUSTOM_AI_CRON_SCHEDULE=*/30 * * * *

# --- Outbound / proxy safety (src/services/OutboundUrlGuard.js) ---
# Comma-separated hostname allowlist for proxied stream URLs (*.example.com or
# .example.com match subdomains). Unset or empty = no hostname restriction
# (private/loopback addresses are always blocked).
# STREAM_PROXY_ALLOWED_HOSTS=
# Extra comma-separated hosts treated as permanently dead (never fetched).
# DEAD_HOSTS=
# SOCKS/HTTP proxy used only for DamiTV requests (DAMITV_PROXY_URL is an alias).
# WARP_PROXY_URL=

# --- Secrets ---
# HMAC secret for signed byte-range segment tokens (SESSION_SECRET is an alias).
# Set a long random value in production; the built-in fallback is public.
# APP_SECRET=

# --- Providers ---
# MadPlay (RBTV+) base domain (src/config.js).
# MADPLAY_BASE_URL=https://jack27eo.mpanrc4imind.my/
# Leaf provider API endpoint and token (a built-in token is used when unset).
# LEAF_API_URL=https://sports.highfly.to
# LEAF_MASTER_TOKEN=
# LiveTV provider
# LIVETV_DISABLED=false
# LIVETV_DAYS_BACK=21
# LIVETV_STREAM_TTL_MS=21600000
# LIVETV_STREAM_CACHE_MAX=500
# ReplayZone page cache
# REPLAYZONE_WEBCACHE_TTL_MS=21600000
# REPLAYZONE_WEBCACHE_MAX=2000
# WatchFooty: how long a dead upstream is skipped
# WATCHFOOTY_DEAD_TTL_MS=300000
# Streamed.pk: max sources decrypted eagerly, WASM worker pool size (1-4)
# STREAMEDPK_MAX_EAGER=4
# STREAMED_WORKER_POOL_SIZE=2
# Set to false to disable the WASM decryptor in EmbedStProvider.
# ENABLE_WASM=true
# DaddyLive timeouts: fixed sync budget (overrides base/max), base, upper clamp,
# and circuit-breaker timeout.
# DADDYLIVE_SYNC_TIMEOUT_MS=
# SYNC_TIMEOUT_BASE_MS=12000
# SYNC_TIMEOUT_MAX_MS=25000
# DADDYLIVE_CB_TIMEOUT_MS=30000
# Resolver (resolver/src/env.js) upstream origins and User-Agent.
# STREAMED_ORIGIN=https://streamed.pk
# EMBED_ORIGIN=https://embed.st
# USER_AGENT=

# --- Stream resolution / verification (src/streams.js) ---
# STREAM_SOFT_DEADLINE_MS=6000
# STREAM_HARD_DEADLINE_MS=15000
# RESOLVE_ATTEMPTS=2
# RESOLVE_TOTAL_BUDGET_MS=12000
# VERIFY_TIMEOUT_MS=5000
# VERIFY_ATTEMPTS=3
# VERIFY_TOTAL_BUDGET_MS=9000
# ENABLE_SPEED_PROBE=true
# SPEED_PROBE_TIMEOUT_MS=5000
# SPEED_PROBE_RANGE_BYTES=524288
# Share resolved streams between PM2 workers via the resolver (false = per-process).
# RESOLVE_CACHE_SHARED=true
# Legacy switch: off forces TIKTOK_SEGMENT_MODE=proxy.
# USE_TIKTOK_BYTERANGE_307=

# --- Catalog / aggregation / prewarm ---
# CATALOG_REVALIDATE_MS=600000
# CATALOG_MEMO_PREWARM=true
# PREWARM_CRON_SCHEDULE=*/3 * * * *
# PREWARM_MAX_MATCHES=12
# PREWARM_MAX_CONCURRENT_MATCHES=2
# PREWARM_MAX_QUEUED_MATCHES=2
# Comma-separated providers skipped by background prewarm (empty = skip none).
# PREWARM_SKIP_PROVIDERS=admin,echo,golf,delta,streamedpk,embedindia,embedst,ppvst,watchfooty
# MERGE_CHUNK_SIZE=25
# CARRY_FORWARD_MAX=600
# Fetch providers sequentially to cut peak memory on small hosts.
# LOW_MEMORY_MODE=false

# --- Team logos ---
# LOGO_ENRICH_CONCURRENCY=8
# TheSportsDB key (123 is the free public test key).
# THESPORTSDB_API_KEY=123
# Override the logo cache path (default: ./data/team_logos_cache.json, then OS temp).
# TEAM_LOGOS_CACHE_FILE=

# --- Cloudflare worker pool (see the budget section above) ---
# Fraction of a free worker's cap at which a background health probe is sent.
# CF_PROBE_THRESHOLD=0.8

# --- impit HTTP client (src/impitClient.js) ---
# IMPIT_RECYCLE_MS=5400000
# IMPIT_TLS_SKIP_TTL_MS=1800000

# --- Misc ---
# Absolute http(s) link for an optional pinned donation stream (unset = none).
# DONATION_URL=https://ko-fi.com/yourname

# Leaf / Highfly live and recap: use your own official install configuration.
# Accepts the free config blob/raw free ID, or a Premium UUID[/profile] or full
# install/configure link. A bare UUID selects Premium, as in the existing setup.
# Account selectors are credentials: keep them out of commits and logs.
LEAF_INSTALL_CONFIG=
# Alternative: the raw freeUserId; the config blob is built from it at runtime.
LEAF_FREE_USER_ID=
# Optional explicit Premium form (takes precedence over the two fields above).
# LEAF_PREMIUM_TOKEN=
# LEAF_PREMIUM_PROFILE=
# Optional origin; explicit Premium fields accept the public premium,
# premium-us2 or premium-eu1 hosts on highfly.to/highfly.dev.
# LEAF_API_ORIGIN=https://premium.highfly.to
# Existing settings keep working; no new variable is required by this update.
# Successful minted URLs retain the existing four-hour default, capped by any
# known upstream expiry. Premium also has limits; 429 Retry-After is honored.
# LEAF_MINT_TTL_MS=14400000
# Whole-base override. Park it on a dead port to disable leaf without a code change:
# LEAF_API_URL=http://127.0.0.1:9/leaf-disabled

# Resolver transport migration (PR #59)
# Default: resolver-dependent /api routes return 503, local provider resolution
# and local resolve cache continue; no URLs/headers are sent to loopback TCP.
# Recommended authenticated mode requires the isolated Unix/TLS setup described
# in docs/RESOLVER_PORT_SAFETY_DRAFT.md and docs/RESOLVER_ISOLATED_TEST_PLAN.md.
# RESOLVER_TRANSPORT=systemd-unix-tls
# Compatibility ONLY when every local process is trusted. This is plaintext,
# unauthenticated TCP, not an ownership check. Only the exact value true enables it.
RESOLVER_TRUST_LEGACY_TCP=false

# ── ScoreZone Provider (testscore.pxxl.pro) ──────────────────────────────────
# Opt-in toggle: defaults to false (disabled). Set to 'true' to enable.
SCOREZONE_ENABLED=false
# Set to 'true' to bypass the curated league whitelist and ingest all fixtures
SCOREZONE_ALL_LEAGUES=false
# Max cache-miss upstream manifest requests per minute per IP (default: 240)
SCOREZONE_RATE_LIMIT=240
